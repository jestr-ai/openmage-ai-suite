<?xml version="1.0"?>
<config>
    <sections>
        <ainative_discovery translate="label" module="ainative_core">
            <label>LLM Discovery</label>
            <tab>ainative</tab>
            <frontend_type>text</frontend_type>
            <sort_order>50</sort_order>
            <show_in_default>1</show_in_default>
            <show_in_website>1</show_in_website>
            <show_in_store>1</show_in_store>
            <groups>
                <general translate="label" module="ainative_core">
                    <label>Product Feed, llms.txt &amp; Catalog API</label>
                    <sort_order>10</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>1</show_in_website>
                    <show_in_store>1</show_in_store>
                    <comment><![CDATA[Feeds: <code>{base_url}ainative-discovery/feed/products/store/{code}.json</code> (or .csv) — rebuilt by cron every 6 hours and on demand. <code>{base_url}llms.txt</code> is served when URL rewrites route it (or use <code>{base_url}ainative-discovery/llms</code>). The catalog API is <code>{base_url}ainative-discovery/catalog</code>.]]></comment>
                    <fields>
                        <enabled translate="label"><label>Enable Discovery Endpoints</label><frontend_type>select</frontend_type><source_model>adminhtml/system_config_source_yesno</source_model><sort_order>10</sort_order><show_in_default>1</show_in_default><show_in_website>1</show_in_website><show_in_store>1</show_in_store></enabled>
                        <feed_token translate="label comment"><label>Feed Access Token</label><frontend_type>text</frontend_type><sort_order>20</sort_order><show_in_default>1</show_in_default><comment>Optional. When set, feeds require ?token=… (or the X-Feed-Token header). Leave empty for public feeds.</comment></feed_token>
                        <llms_txt translate="label"><label>Serve llms.txt</label><frontend_type>select</frontend_type><source_model>adminhtml/system_config_source_yesno</source_model><sort_order>30</sort_order><show_in_default>1</show_in_default><show_in_website>1</show_in_website><show_in_store>1</show_in_store></llms_txt>
                        <catalog_api translate="label comment"><label>Serve Catalog JSON API</label><frontend_type>select</frontend_type><source_model>adminhtml/system_config_source_yesno</source_model><sort_order>40</sort_order><show_in_default>1</show_in_default><show_in_website>1</show_in_website><show_in_store>1</show_in_store><comment>Public, read-only, cached: categories and products with shopper prices for AI agents to browse without scraping HTML.</comment></catalog_api>
                        <include_out_of_stock translate="label"><label>Include Out-of-stock Products</label><frontend_type>select</frontend_type><source_model>adminhtml/system_config_source_yesno</source_model><sort_order>50</sort_order><show_in_default>1</show_in_default><show_in_website>1</show_in_website><show_in_store>1</show_in_store></include_out_of_stock>
                        <brand_attribute translate="label"><label>Brand Attribute Code</label><frontend_type>text</frontend_type><sort_order>60</sort_order><show_in_default>1</show_in_default></brand_attribute>
                        <gtin_attribute translate="label comment"><label>GTIN/EAN/UPC Attribute Code</label><frontend_type>text</frontend_type><sort_order>70</sort_order><show_in_default>1</show_in_default><comment>Strongly recommended: agents match products across merchants by GTIN.</comment></gtin_attribute>
                        <mpn_attribute translate="label"><label>MPN Attribute Code</label><frontend_type>text</frontend_type><sort_order>80</sort_order><show_in_default>1</show_in_default></mpn_attribute>
                        <condition translate="label"><label>Default Condition</label><frontend_type>select</frontend_type><source_model>ainative_discovery/config_source_condition</source_model><sort_order>90</sort_order><show_in_default>1</show_in_default></condition>
                        <seller_name translate="label"><label>Seller Name (feed)</label><frontend_type>text</frontend_type><sort_order>100</sort_order><show_in_default>1</show_in_default><show_in_website>1</show_in_website><show_in_store>1</show_in_store></seller_name>
                        <return_policy_url translate="label"><label>Return Policy URL</label><frontend_type>text</frontend_type><sort_order>110</sort_order><show_in_default>1</show_in_default><show_in_website>1</show_in_website><show_in_store>1</show_in_store></return_policy_url>
                        <shipping_note translate="label comment"><label>Shipping Summary</label><frontend_type>textarea</frontend_type><sort_order>120</sort_order><show_in_default>1</show_in_default><show_in_website>1</show_in_website><show_in_store>1</show_in_store><comment>One or two lines for llms.txt and the feed, e.g. "Free shipping over $50, 2–4 business days in the US."</comment></shipping_note>
                    </fields>
                </general>
            </groups>
        </ainative_discovery>
    </sections>
</config>
