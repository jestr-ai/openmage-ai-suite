<?xml version="1.0"?>
<config>
    <sections>
        <ainative_copilot translate="label" module="ainative_core">
            <label>Admin Copilot</label>
            <tab>ainative</tab>
            <frontend_type>text</frontend_type>
            <sort_order>30</sort_order>
            <show_in_default>1</show_in_default>
            <show_in_website>1</show_in_website>
            <show_in_store>1</show_in_store>
            <groups>
                <general translate="label" module="ainative_core">
                    <label>Content Generation &amp; Ask Your Store</label>
                    <sort_order>10</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>1</show_in_website>
                    <show_in_store>1</show_in_store>
                    <fields>
                        <enabled translate="label">
                            <label>Enable Copilot</label>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                        </enabled>
                        <tone translate="label">
                            <label>Default Tone</label>
                            <frontend_type>select</frontend_type>
                            <source_model>ainative_copilot/config_source_tone</source_model>
                            <sort_order>20</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </tone>
                        <language translate="label comment">
                            <label>Output Language</label>
                            <frontend_type>text</frontend_type>
                            <sort_order>30</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                            <comment>e.g. "English (UK)", "Deutsch", "Français". Empty = the store view's locale language.</comment>
                        </language>
                        <brand_guidelines translate="label comment">
                            <label>Brand &amp; Style Guidelines</label>
                            <frontend_type>textarea</frontend_type>
                            <sort_order>40</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                            <comment>Words to use/avoid, claims never to make, formatting preferences. Added to every generation prompt.</comment>
                        </brand_guidelines>
                        <jobs_per_run translate="label comment">
                            <label>Bulk Jobs per Cron Run</label>
                            <frontend_type>text</frontend_type>
                            <validate>validate-digits</validate>
                            <sort_order>50</sort_order>
                            <show_in_default>1</show_in_default>
                            <comment>Cron runs every minute; this bounds provider spend per minute.</comment>
                        </jobs_per_run>
                        <ask_history translate="label">
                            <label>Ask: Messages Kept per Conversation</label>
                            <frontend_type>text</frontend_type>
                            <validate>validate-digits</validate>
                            <sort_order>60</sort_order>
                            <show_in_default>1</show_in_default>
                        </ask_history>
                    </fields>
                </general>
            </groups>
        </ainative_copilot>
    </sections>
</config>
