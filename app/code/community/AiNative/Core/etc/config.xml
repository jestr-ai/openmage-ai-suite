<?xml version="1.0"?>
<!--
/**
 * OpenMage AI Suite — Core
 * Provider abstraction (Anthropic / OpenAI / Gemini), tool registry, agent loop, audit log.
 * @license MIT
 */
-->
<config>
    <modules>
        <AiNative_Core>
            <version>1.0.0</version>
        </AiNative_Core>
    </modules>

    <global>
        <models>
            <ainative_core>
                <class>AiNative_Core_Model</class>
                <resourceModel>ainative_core_resource</resourceModel>
            </ainative_core>
            <ainative_core_resource>
                <class>AiNative_Core_Model_Resource</class>
                <entities>
                    <audit><table>ainative_audit</table></audit>
                    <usage><table>ainative_usage</table></usage>
                    <rate_limit><table>ainative_rate_limit</table></rate_limit>
                </entities>
            </ainative_core_resource>
        </models>
        <helpers>
            <ainative_core>
                <class>AiNative_Core_Helper</class>
            </ainative_core>
        </helpers>
        <blocks>
            <ainative_core>
                <class>AiNative_Core_Block</class>
            </ainative_core>
        </blocks>
        <resources>
            <ainative_core_setup>
                <setup>
                    <module>AiNative_Core</module>
                    <class>Mage_Core_Model_Resource_Setup</class>
                </setup>
            </ainative_core_setup>
        </resources>

        <!--
            Tool registry. Other modules add tools here:
              <ainative_tools><admin><my_tool><class>my_module/tool_myTool</class></my_tool></admin></ainative_tools>
            Scope "admin" tools run as an admin user and are ACL-checked; "storefront" tools run as customer/guest.
        -->
        <ainative_tools>
            <admin/>
            <storefront/>
        </ainative_tools>
    </global>

    <admin>
        <routers>
            <adminhtml>
                <args>
                    <modules>
                        <AiNative_Core before="Mage_Adminhtml">AiNative_Core_Adminhtml</AiNative_Core>
                    </modules>
                </args>
            </adminhtml>
        </routers>
    </admin>

    <adminhtml>
        <layout>
            <updates>
                <ainative_core>
                    <file>ainative/core.xml</file>
                </ainative_core>
            </updates>
        </layout>
        <translate>
            <modules>
                <AiNative_Core>
                    <files><default>AiNative_Core.csv</default></files>
                </AiNative_Core>
            </modules>
        </translate>
    </adminhtml>

    <crontab>
        <jobs>
            <ainative_core_purge_audit>
                <schedule><cron_expr>30 3 * * *</cron_expr></schedule>
                <run><model>ainative_core/cron::purgeAudit</model></run>
            </ainative_core_purge_audit>
        </jobs>
    </crontab>

    <default>
        <ainative>
            <general>
                <enabled>0</enabled>
                <provider>anthropic</provider>
                <max_tokens>4096</max_tokens>
                <temperature>0.3</temperature>
                <timeout>60</timeout>
                <max_iterations>8</max_iterations>
                <store_context></store_context>
            </general>
            <anthropic>
                <api_key backend_model="adminhtml/system_config_backend_encrypted"/>
                <model>claude-opus-5</model>
                <effort>low</effort>
                <base_url>https://api.anthropic.com</base_url>
            </anthropic>
            <openai>
                <api_key backend_model="adminhtml/system_config_backend_encrypted"/>
                <model>gpt-4.1-mini</model>
                <base_url>https://api.openai.com/v1</base_url>
            </openai>
            <gemini>
                <api_key backend_model="adminhtml/system_config_backend_encrypted"/>
                <model>gemini-2.5-flash</model>
                <base_url>https://generativelanguage.googleapis.com/v1beta</base_url>
            </gemini>
            <security>
                <allow_write_tools>0</allow_write_tools>
                <redact_pii>1</redact_pii>
                <monthly_token_budget>0</monthly_token_budget>
                <rate_limit_per_minute>30</rate_limit_per_minute>
                <audit_retention_days>90</audit_retention_days>
                <debug_log>0</debug_log>
            </security>
        </ainative>
    </default>
</config>
