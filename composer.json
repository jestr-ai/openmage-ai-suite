{
    "name": "jestr-ai/openmage-ai-suite",
    "description": "AI-native suite for OpenMage / Magento 1: MCP server, admin copilot, storefront assistant, LLM discovery layer. Bring your own key (Anthropic, OpenAI, Gemini).",
    "type": "magento-module",
    "license": "MIT",
    "keywords": ["openmage", "magento1", "ai", "mcp", "llm", "chatbot", "anthropic", "openai", "gemini"],
    "homepage": "https://github.com/jestr-ai/openmage-ai-suite",
    "require": {
        "php": ">=8.1 <8.6",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "magento-hackathon/magento-composer-installer": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.60"
    },
    "extra": {
        "magento-root-dir": ".",
        "magento-deploystrategy": "copy",
        "map": [
            ["app/code/community/AiNative", "app/code/community/AiNative"],
            ["app/etc/modules/AiNative_Core.xml", "app/etc/modules/AiNative_Core.xml"],
            ["app/etc/modules/AiNative_Mcp.xml", "app/etc/modules/AiNative_Mcp.xml"],
            ["app/etc/modules/AiNative_Copilot.xml", "app/etc/modules/AiNative_Copilot.xml"],
            ["app/etc/modules/AiNative_Assistant.xml", "app/etc/modules/AiNative_Assistant.xml"],
            ["app/etc/modules/AiNative_Discovery.xml", "app/etc/modules/AiNative_Discovery.xml"],
            ["app/design/adminhtml/default/default/layout/ainative", "app/design/adminhtml/default/default/layout/ainative"],
            ["app/design/adminhtml/default/default/template/ainative", "app/design/adminhtml/default/default/template/ainative"],
            ["app/design/frontend/base/default/layout/ainative", "app/design/frontend/base/default/layout/ainative"],
            ["app/design/frontend/base/default/template/ainative", "app/design/frontend/base/default/template/ainative"],
            ["skin/adminhtml/default/default/ainative", "skin/adminhtml/default/default/ainative"],
            ["skin/frontend/base/default/ainative", "skin/frontend/base/default/ainative"],
            ["app/locale/en_US/AiNative_Core.csv", "app/locale/en_US/AiNative_Core.csv"]
        ]
    },
    "scripts": {
        "phpstan": "phpstan analyse --configuration=.phpstan.dist.neon",
        "cs": "php-cs-fixer fix --dry-run --diff --config=.php-cs-fixer.dist.php",
        "cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "test": "phpunit --configuration=.phpunit.dist.xml"
    },
    "config": {
        "allow-plugins": {
            "magento-hackathon/magento-composer-installer": true
        }
    }
}
